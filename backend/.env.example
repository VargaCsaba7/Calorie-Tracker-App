# Copy to .env and adjust values.
# MySQL (XAMPP default: root user, no password). Create the database first, see README.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/calorie_tracker?charset=utf8mb4
# SQLite (no server needed, handy for quick tests):
# DATABASE_URL=sqlite:///./tracker.db

# Used for JWT signing in Phase 2. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]

# Optional: AI meal estimate ("a plate of goulash" -> calories and macros).
# Default: a free model running locally with Ollama (https://ollama.com).
# Install Ollama, then download the model once:  ollama pull qwen2.5:7b
AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Or use Claude (paid, more accurate): set AI_PROVIDER=anthropic and a key from https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
