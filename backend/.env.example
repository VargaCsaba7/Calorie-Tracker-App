# Copy to .env and adjust values.
DATABASE_URL=sqlite:///./tracker.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tracker

# Used for JWT signing in Phase 2. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]
